# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Lessons use CLAUDE_MODEL (quality), chat replies and triage use CLAUDE_CHAT_MODEL (speed, volume). Cheaper: CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_CHAT_MODEL=claude-sonnet-5
# BRAIN_BACKEND=api uses the API key above. BRAIN_BACKEND=claude_code runs through Claude Code's harness with the claude.ai login
# on this machine (run `claude` once and /login). Subscription usage windows apply; the stream falls back to templates when exhausted.
BRAIN_BACKEND=api
# Optional: free key from https://twelvedata.com (forex + US stocks). Without it, yfinance is used.
TWELVEDATA_KEY=
# Your TikTok handle without the @, used to read LIVE chat
TIKTOK_UNIQUE_ID=
# Audio output device name substring for the TTS voice (VB-Cable input side)
AUDIO_DEVICE=CABLE Input
# Voice id: Edge names like en-US-AndrewMultilingualNeural, en-GB-RyanNeural; Kokoro ids like am_michael
TTS_VOICE=en-US-AndrewMultilingualNeural
# Show energy 0..1 (0.85 = upbeat show host: fast welcomes, like goals, live-move reactions, cliffhangers; 0.5 = calm teacher)
ENERGY=0.85
# Voice engine: edge (online, free, natural) or kokoro (local GPU, offline)
TTS_ENGINE=chatterbox   # chatterbox (expressive, local GPU, performs [laugh] [sigh]) | edge (online) | kokoro (local, plain)
# Supermemory API key (supermemory.ai) for long-term memory of viewers and past lessons
SUPERMEMORY_API_KEY=

# Console "Popular music" toggle (online bed from Audius): which trending genres and which search words make the mix.
MUSIC_ONLINE_GENRES=all,Hip-Hop/Rap,Pop,Electronic,Dancehall
MUSIC_ONLINE_SEARCH=afrobeats,afrobeat,amapiano,afropop,tiktok,viral
